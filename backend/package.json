{
  "name": "app",
  "version": "1.0.0",
  "description": "",
  "main": "app.js",
  "scripts": {
    "start": "node dist/app.js",
    "build": "tsc",
    "dev": "cross-env NODE_ENV=dev nodemon --watch src --exec ts-node src/app.ts",
    "testing": "cross-env NODE_ENV=test nodemon --watch src --exec ts-node src/app.ts",
    "api:spec-convert": "redocly bundle ./src/openapi/voicevox/openapi.yaml -o ./src/openapi/voicevox/openapi.formatted.yaml --config .redocly.lint.with-translations.yaml",
    "api:spec-sprit": "redocly split ./src/openapi/voicevox/openapi.formatted.yaml --outDir ./src/openapi/voicevox/spec",
    "openapi": "pnpm run api:spec-convert && pnpm run api:spec-sprit && pnpm orval",
    "bff-openapi-preview": "cd src/openapi/bff/spec/  && redocly preview"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@codegenie/serverless-express": "^4.16.0",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-jwt": "^8.5.1",
    "jwks-rsa": "^3.2.0",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.10.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@redocly/cli": "^2.14.5",
    "@types/aws-lambda": "^8.10.146",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "nodemon": "^3.1.9",
    "orval": "^8.0.1",
    "prettier": "^3.8.0",
    "serverless-offline": "^14.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
